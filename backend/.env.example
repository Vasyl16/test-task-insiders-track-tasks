PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_tracker?schema=public
CORS_ORIGIN=http://localhost:5173
# Required, at least 32 characters - the app fails to start otherwise.
# Generate one with: openssl rand -hex 32
JWT_ACCESS_SECRET=your_jwt_access_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
EMAIL_FROM=your_gmail_address@gmail.com
EMAIL_TOKEN=your_gmail_app_password
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=1800
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10